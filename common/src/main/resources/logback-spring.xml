<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- 프로퍼티 정의 -->
    <!-- spring.application.name을 사용하여 서버별로 로그 파일 분리 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="application"/>
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>
    <property name="LOG_FILE" value="${LOG_FILE:-${APP_NAME}}"/>
    <property name="LOG_FILE_MAX_SIZE" value="100MB"/>
    <property name="LOG_FILE_MAX_HISTORY" value="30"/>
    
    <!-- 콘솔 출력 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} T:%-32X{traceId} S:%-16X{spanId} L:%-5level %logger{36} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    
    <!-- 일반 애플리케이션 로그 파일 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} T:%-32X{traceId} S:%-16X{spanId} L:%-5level %logger{36} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- HTTP 요청/응답 로그 파일 (별도 파일, 서버별로 분리) -->
    <appender name="HTTP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-http-request-response.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} T:%-32X{traceId} S:%-16X{spanId} L:%-5level %logger{36} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-http-request-response-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
            <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- 필요한 것만 INFO로 유지 (로거 계층 구조상 더 구체적인 패키지가 우선) -->
    <logger name="com.aiwellness.common.logging.HttpLoggingFilter" level="INFO" additivity="false">
        <appender-ref ref="HTTP_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="com.aiwellness.common.exception" level="INFO"/>
    <logger name="com.aiwellness.common.security" level="INFO"/>
    <!-- Query 로깅은 INFO 유지 -->
    <logger name="org.apache.ibatis" level="INFO"/>
    <logger name="java.sql" level="INFO"/>
    
    <!-- Application 로그는 기본적으로 INFO, 상세 로그는 DEBUG로 -->
    <logger name="com.aiwellness" level="INFO"/>
    <!-- Controller, Service, Adapter 등의 상세 로그는 DEBUG로 -->
    <logger name="com.aiwellness.admin.adapter.web" level="DEBUG"/>
    <logger name="com.aiwellness.manager.adapter.web" level="DEBUG"/>
    <logger name="com.aiwellness.customer.adapter.web" level="DEBUG"/>
    <logger name="com.aiwellness.admin.application.service" level="DEBUG"/>
    <logger name="com.aiwellness.manager.application.service" level="DEBUG"/>
    <logger name="com.aiwellness.customer.application.service" level="DEBUG"/>
    <logger name="com.aiwellness.admin.adapter.persistence" level="DEBUG"/>
    <logger name="com.aiwellness.manager.adapter.persistence" level="DEBUG"/>
    <logger name="com.aiwellness.customer.adapter.persistence" level="DEBUG"/>
    <logger name="com.aiwellness.admin.adapter.security" level="DEBUG"/>
    <logger name="com.aiwellness.manager.adapter.security" level="DEBUG"/>
    <logger name="com.aiwellness.customer.adapter.security" level="DEBUG"/>
    
    <!-- Spring Framework 로그는 최소화 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.boot" level="WARN"/>
    <logger name="org.springframework.context" level="WARN"/>
    
    <!-- 루트 로거 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
    
    <!-- 개발 환경 설정 -->
    <springProfile name="dev">
        <!-- 개발 환경에서는 콘솔에도 출력 -->
    </springProfile>
    
    <!-- 운영 환경 설정 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="FILE"/>
        </root>
        <!-- 운영 환경에서는 콘솔 출력 최소화 -->
        <logger name="com.aiwellness.common.logging.HttpLoggingFilter" level="INFO" additivity="false">
            <appender-ref ref="HTTP_FILE"/>
        </logger>
    </springProfile>
</configuration>

