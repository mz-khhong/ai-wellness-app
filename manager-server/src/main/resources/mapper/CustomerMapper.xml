<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiwellness.manager.adapter.persistence.customer.CustomerMapper">

    <resultMap id="customerResultMap" type="com.aiwellness.manager.domain.model.customer.Customer">
        <id property="id" column="id"/>
        <result property="facilityGroupId" column="facility_group_id"/>
        <result property="uuid" column="uuid"/>
        <result property="email" column="email"/>
        <result property="name" column="name"/>
        <result property="password" column="password"/>
        <result property="status" column="status" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" parameterType="long" resultMap="customerResultMap">
        SELECT id, facility_group_id, uuid, email, name, password, status, created_at, updated_at
        FROM customers
        WHERE id = #{id}
    </select>

    <select id="findByFacilityGroupId" parameterType="long" resultMap="customerResultMap">
        SELECT id, facility_group_id, uuid, email, name, password, status, created_at, updated_at
        FROM customers
        WHERE facility_group_id = #{facilityGroupId}
        ORDER BY created_at DESC
    </select>

</mapper>

